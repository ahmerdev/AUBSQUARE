# Copy to .env and edit.  NEVER commit the real .env file.

# ---- Core -------------------------------------------------------------
DJANGO_DEBUG=False                      # True only on your own computer
DJANGO_SECRET_KEY=                      # required when DEBUG is False: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=aubsquare.com,www.aubsquare.com
SITE_URL=https://aubsquare.com
CSRF_TRUSTED_ORIGINS=https://aubsquare.com,https://www.aubsquare.com
CORS_ALLOWED_ORIGINS=https://aubsquare.com,https://www.aubsquare.com
TIME_ZONE=Asia/Karachi

# Encrypts SMTP/IMAP/AI credentials saved from the dashboard. Generate once and keep it safe (losing it means re-entering them):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
VISITOR_HASH_SALT=

# ---- Database (SQLite by default; PostgreSQL recommended in production) ---
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=aubsquare
# DB_USER=aubsquare
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ---- Hosting ----------------------------------------------------------
TRUST_X_FORWARDED_FOR=False             # True only behind your own reverse proxy
SECURE_SSL_REDIRECT=True
SERVE_MEDIA=False                       # True if no nginx/CDN serves /media/
MEDIA_ROOT=
MEDIA_MAX_UPLOAD_MB=8
FRONTEND_DIST=                          # path to the built React site (npm run build); default ../dist

# ---- Optional first-run admin (used once by `manage.py bootstrap_admin`) ---
# AUB_ADMIN_EMAIL=
# AUB_ADMIN_PASSWORD=

# Branding live preview: where the website runs when Django does not serve it (npm run dev) – optional
# PREVIEW_SITE_URL=http://localhost:3000

# ---- Free website audit (public lead magnet) -------------------------------
# FREE_AUDIT_DAILY_CAP=80        # max audits per day across all visitors
# THROTTLE_AUDIT=6/hour          # per visitor
# THROTTLE_AUDIT_LEAD=6/hour
